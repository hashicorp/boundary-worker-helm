{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "HashiCorp Boundary Worker Helm Chart Values Schema",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "ops": {
          "type": "object",
          "properties": {
            "disabled": {
              "type": "boolean"
            }
          }
        },
        "secretName": {
          "type": "string"
        },
        "mountPath": {
          "type": "string"
        }
      }
    },
    "secretRefs": {
      "type": "object",
      "properties": {
        "secretName": {
          "type": "string"
        },
        "validateExisting": {
          "type": "boolean"
        },
        "keys": {
          "type": "object",
          "properties": {
            "controllerGeneratedActivationToken": {
              "type": "string"
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "config": {
          "type": "string"
        },
        "livenessProbe": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readinessProbe": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "service": {
          "type": "object",
          "properties": {
            "proxy": {
              "$ref": "#/definitions/service"
            },
            "ops": {
              "$ref": "#/definitions/service"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "recording": {
              "$ref": "#/definitions/persistence"
            },
            "authStorage": {
              "$ref": "#/definitions/persistence"
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "openshift": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "route": {
          "type": "object",
          "properties": {
            "proxy": {
              "$ref": "#/definitions/proxyRoute"
            },
            "ops": {
              "$ref": "#/definitions/opsRoute"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "accessMode": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "retainOnUninstall": {
          "type": "boolean"
        }
      }
    },
    "proxyRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "opsRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "properties": {
            "termination": {
              "type": "string",
              "enum": [
                "passthrough",
                "edge",
                "reencrypt"
              ]
            },
            "insecureEdgeTerminationPolicy": {
              "type": "string",
              "enum": [
                "Allow",
                "Redirect",
                "None"
              ]
            },
            "destinationCACertificate": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    }
  }
}
